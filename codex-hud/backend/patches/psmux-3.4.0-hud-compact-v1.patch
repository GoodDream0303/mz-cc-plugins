+use ratatui::layout::Rect;
+
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicU8};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+
+
+const ROWS: u16 = 6;
+const COLS: u16 = 40;
+
+// ── PTY-free pane scaffolding ──────────────────────────────────────────────
+
+#[derive(Debug)]
+struct DummyChild { exited: bool }
+
+#[derive(Debug)]
+struct DummyWriter;
+
+struct DummyMaster { resize_calls: Option<Arc<AtomicU64>> }
+
+impl crate::pane::PaneInputSink for DummyWriter {}
+
+impl std::io::Write for DummyWriter {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> { Ok(buf.len()) }
+    fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+}
+
+impl portable_pty::ChildKiller for DummyChild {
+    fn kill(&mut self) -> std::io::Result<()> { Ok(()) }
+    fn clone_killer(&self) -> Box<dyn portable_pty::ChildKiller + Send + Sync> {
+        Box::new(DummyChild { exited: self.exited })
+    }
+}
+
+impl portable_pty::Child for DummyChild {
+    fn try_wait(&mut self) -> std::io::Result<Option<portable_pty::ExitStatus>> {
+        Ok(if self.exited { Some(portable_pty::ExitStatus::with_exit_code(0)) } else { None })
+    }
+    fn wait(&mut self) -> std::io::Result<portable_pty::ExitStatus> {
+        Ok(portable_pty::ExitStatus::with_exit_code(0))
+    }
+    fn process_id(&self) -> Option<u32> { None }
+    #[cfg(windows)]
+    fn as_raw_handle(&self) -> Option<std::os::windows::io::RawHandle> { None }
+}
+
+impl portable_pty::MasterPty for DummyMaster {
+    fn resize(&self, _size: portable_pty::PtySize) -> Result<(), anyhow::Error> {
+        if let Some(calls) = &self.resize_calls {
+            calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        }
+        Ok(())
+    }
+    fn get_size(&self) -> Result<portable_pty::PtySize, anyhow::Error> {
+        Ok(portable_pty::PtySize { rows: ROWS, cols: COLS, pixel_width: 0, pixel_height: 0 })
+    }
+    fn try_clone_reader(&self) -> Result<Box<dyn std::io::Read + Send>, anyhow::Error> {
+        Ok(Box::new(std::io::empty()))
+    }
+    fn take_writer(&self) -> Result<Box<dyn std::io::Write + Send>, anyhow::Error> {
+        Ok(Box::new(DummyWriter))
+    }
+    #[cfg(unix)]
+    fn process_group_leader(&self) -> Option<i32> { None }
+    #[cfg(unix)]
+    fn as_raw_fd(&self) -> Option<std::os::unix::io::RawFd> { None }
+    #[cfg(unix)]
+    fn tty_name(&self) -> Option<std::path::PathBuf> { None }
+}
+
+fn make_pane(id: usize, rows: u16, cols: u16) -> crate::types::Pane {
+    let term = Arc::new(Mutex::new(vt100::Parser::new(rows, cols, 0)));
+    let epoch = Instant::now() - Duration::from_secs(2);
+    crate::types::Pane {
+        master: Box::new(DummyMaster { resize_calls: None }),
+        writer: Box::new(DummyWriter),
+        child: Box::new(DummyChild { exited: false }),
+        term,
+        last_rows: rows,
+        last_cols: cols,
+        id,
+        title: format!("pane{id}"),
+        title_locked: false,
+        child_pid: None,
+        data_version: Arc::new(AtomicU64::new(0)),
+        last_title_check: epoch,
+        last_infer_title: epoch,
+        dead: false,
+        last_text_input: None,
+        last_special_key: None,
+        vt_bridge_cache: None,
+        vti_mode_cache: None,
+        mouse_input_cache: None, win32_input_latched: false, input_off: false,
+        scroll_fg_cache: None, mouse_proto_owner: None, wheel_auth: None,
+        cursor_shape: Arc::new(AtomicU8::new(0)),
+        bell_pending: Arc::new(AtomicBool::new(false)),
+        cpr_pending: Arc::new(AtomicBool::new(false)),
+        color_query_pending: Arc::new(std::sync::atomic::AtomicU32::new(0)),
+        copy_state: None, live_term: None,
+        pane_style: None, pane_options: Default::default(),
+        squelch_until: None,
+        output_ring: Arc::new(Mutex::new(std::collections::VecDeque::new())),
+        spawned_at: None,
+        start_command: String::new(),
+        cwd_hint: None,
+    }
+}
+
+fn make_window(id: usize) -> crate::types::Window {
+    crate::types::Window {
+        root: Node::Split { kind: crate::types::LayoutKind::Horizontal, sizes: vec![], children: vec![] },
+        active_path: vec![],
+        name: "w".to_string(),
+        id,
+        area: ratatui::layout::Rect::new(0, 0, 120, 30),
+        window_size: None,
+        window_options: Default::default(),
+        activity_flag: false,
+        bell_flag: false,
+        silence_flag: false,
+        last_output_time: Instant::now(),
+        last_seen_version: 0,
+        manual_rename: false,
+        layout_index: 0,
+        pane_mru: vec![],
+        zoom_saved: None,
+        linked_from: None,
+        floating: Vec::new(),
+        floating_focus: None,
+    }
+}
+
+
+fn app_with_stack(height: u16, sizes: Vec<u16>) -> AppState {
+    let mut app = AppState::new("compact-lifecycle".to_string());
+    let mut win = make_window(1);
+    win.area = Rect::new(0, 0, 120, height);
+    win.root = Node::Split { kind: LayoutKind::Vertical, sizes,
+        children: vec![Node::Leaf(make_pane(1, 24, 120)), Node::Leaf(make_pane(2, 6, 120))] };
+    win.active_path = vec![1];
+    app.last_window_area = win.area;
+    app.windows.push(win);
+    app.active_idx = 0;
+    app
+}
+fn pane_height(root: &Node, area: Rect, path: &[usize]) -> u16 {
+    let mut rects = Vec::new();
+    crate::tree::compute_rects(root, area, &mut rects);
+    rects.iter().find(|(actual, _)| actual.as_slice() == path).unwrap().1.height
+}
+#[test]
+fn absolute_resize_after_viewport_growth_targets_actual_cells() {
+    let mut app = app_with_stack(60, vec![24, 6]);
+    crate::window_ops::resize_pane_absolute(&mut app, "y", 6);
+    let win = &app.windows[0];
+    assert_eq!(pane_height(&win.root, win.area, &[1]), 6);
+}
+#[test]
+fn relative_resize_after_viewport_growth_moves_the_requested_rows() {
+    let mut app = app_with_stack(60, vec![24, 6]);
+    crate::window_ops::resize_pane_vertical(&mut app, 3);
+    let win = &app.windows[0];
+    assert_eq!(pane_height(&win.root, win.area, &[1]), 9);
+}
+#[test]
+fn unrelated_exit_preserves_compact_hud_height() {
+    let app = app_with_stack(130, vec![124, 6]);
+    let stack = app.windows.into_iter().next().unwrap().root;
+    let mut exited = make_pane(3, 130, 120);
+    exited.child = Box::new(DummyChild { exited: true });
+    let root = Node::Split { kind: LayoutKind::Horizontal, sizes: vec![50, 50],
+        children: vec![stack, Node::Leaf(exited)] };
+    let (pruned, dead) = crate::tree::prune_exited(root, false, false);
+    assert_eq!(dead, 0);
+    let pruned = pruned.unwrap();
+    assert_eq!(pane_height(&pruned, Rect::new(0, 0, 120, 130), &[1]), 6);
+}
+#[test]
+fn retained_exit_never_changes_compact_geometry_without_a_resize() {
+    let mut app = app_with_stack(130, vec![124, 6]);
+    if let Node::Split { children, .. } = &mut app.windows[0].root {
+        if let Node::Leaf(pane) = &mut children[1] {
+            pane.child = Box::new(DummyChild { exited: true });
+            pane.pane_options.insert("remain-on-exit".to_string(), "on".to_string());
+        }
+    }
+    let root = app.windows.into_iter().next().unwrap().root;
+    let (pruned, dead) = crate::tree::prune_exited(root, false, false);
+    assert_eq!(dead, 1);
+    assert_eq!(pane_height(&pruned.unwrap(), Rect::new(0, 0, 120, 130), &[1]), 6);
+}
+
+#[test]
+fn nested_absolute_resize_uses_its_parent_extent() {
+    let mut app = app_with_stack(60, vec![24, 6]);
+    let win = &mut app.windows[0];
+    let stack = std::mem::replace(&mut win.root, Node::Split { kind: LayoutKind::Vertical, sizes: vec![], children: vec![] });
+    win.root = Node::Split { kind: LayoutKind::Vertical, sizes: vec![1, 1],
+        children: vec![stack, Node::Leaf(make_pane(3, 30, 120))] };
+    win.active_path = vec![0, 1];
+    crate::window_ops::resize_pane_absolute(&mut app, "y", 4);
+    let win = &app.windows[0];
+    assert_eq!(pane_height(&win.root, win.area, &[0, 1]), 4);
+    assert_eq!(pane_height(&win.root, win.area, &[1]), 30);
+}
+
+fn rejected_resize_preserves_nested_weights(relative: bool) {
+    for height in [1, 3] {
+        // The nested split gets zero rows or one row, respectively.
+        let mut app = app_with_stack(height, vec![24, 6]);
+        let win = &mut app.windows[0];
+        let stack = std::mem::replace(&mut win.root, Node::Split { kind: LayoutKind::Vertical, sizes: vec![], children: vec![] });
+        win.root = Node::Split { kind: LayoutKind::Vertical, sizes: vec![1, 1],
+            children: vec![stack, Node::Leaf(make_pane(3, height, 120))] };
+        win.active_path = vec![0, 1];
+        if relative { crate::window_ops::resize_pane_vertical(&mut app, 1); }
+        else { crate::window_ops::resize_pane_absolute(&mut app, "y", 6); }
+        let win = &mut app.windows[0];
+        let Node::Split { children, .. } = &win.root else { panic!("outer split lost"); };
+        let Node::Split { sizes, .. } = &children[0] else { panic!("inner split lost"); };
+        assert_eq!(sizes, &[24, 6], "rejected resize mutated weights at outer height {height}");
+        win.area.height = 60;
+        let mut rects = Vec::new();
+        crate::tree::compute_rects(&win.root, win.area, &mut rects);
+        let first = rects.iter().find(|(path, _)| path == &[0, 0]).unwrap().1;
+        let hud = rects.iter().find(|(path, _)| path == &[0, 1]).unwrap().1;
+        assert!(first.y + first.height <= hud.y, "panes overlap after growth");
+        assert_eq!(hud.height, 6);
+    }
+}
+#[test]
+fn rejected_relative_resize_preserves_hidden_split_until_growth() {
+    rejected_resize_preserves_nested_weights(true);
+}
+#[test]
+fn rejected_absolute_resize_preserves_hidden_split_until_growth() {
+    rejected_resize_preserves_nested_weights(false);
+}
