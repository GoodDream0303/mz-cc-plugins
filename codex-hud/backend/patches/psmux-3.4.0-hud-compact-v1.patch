+#[test]
+fn held_drag_resizes_pty_and_parser_before_done_and_skips_duplicate_dimensions() {
+    let mut app = app_with_stack(30, vec![24, 6]);
+    let counters = [Arc::new(AtomicU64::new(0)), Arc::new(AtomicU64::new(0))];
+    let Node::Split { children, .. } = &mut app.windows[0].root else { panic!("split missing"); };
+    for (index, child) in children.iter_mut().enumerate() {
+        let Node::Leaf(pane) = child else { panic!("pane missing"); };
+        pane.master = Box::new(DummyMaster { resize_calls: Some(counters[index].clone()) });
+    }
+    // This is the held-drag command. There is deliberately no ResizeDone yet.
+    crate::window_ops::handle_split_set_sizes(&mut app, &[], &[20, 10]);
+    let win = &app.windows[0];
+    let Node::Split { children, .. } = &win.root else { panic!("split missing"); };
+    for (index, expected) in [20, 10].into_iter().enumerate() {
+        let Node::Leaf(pane) = &children[index] else { panic!("pane missing"); };
+        assert_eq!(pane.last_rows, expected, "PTY metadata trails the held-drag layout");
+        assert_eq!(pane.term.lock().unwrap().screen().size(), (expected, 120));
+        assert_eq!(counters[index].load(std::sync::atomic::Ordering::SeqCst), 1);
+    }
+    crate::window_ops::handle_split_set_sizes(&mut app, &[], &[20, 10]);
+    crate::window_ops::handle_split_resize_done(&mut app);
+    for calls in counters {
+        assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 1,
+            "duplicate drag dimensions or Done triggered another physical resize");
+    }
+}
