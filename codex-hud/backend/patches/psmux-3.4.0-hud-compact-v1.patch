@@ -0,0 +1,114 @@
+use super::*;
+use ratatui::backend::TestBackend;
+
+fn pane(id: usize, active: bool, lines: &[&str]) -> LayoutJson {
+    serde_json::from_value(serde_json::json!({
+        "type": "leaf", "id": id, "rows": lines.len(), "cols": 12,
+        "cursor_row": 0, "cursor_col": 0, "active": active,
+        "copy_mode": false, "scroll_offset": 0,
+        "rows_v2": lines.iter().map(|text| serde_json::json!({"runs": [{
+            "text": format!("{text:<12}"), "width": 12,
+            "fg": "red", "bg": "blue", "flags": 2
+        }]})).collect::<Vec<_>>()
+    })).unwrap()
+}
+
+fn layout() -> LayoutJson {
+    LayoutJson::Split {
+        kind: "Vertical".to_string(), sizes: vec![1, 1],
+        children: vec![pane(1, true, &["HELLO", "? shortcuts"]), pane(2, false, &["HUD", "row2"])],
+    }
+}
+
+#[test]
+fn compact_draw_preserves_footer_text_and_colors_without_separator_row() {
+    let mut terminal = Terminal::new(TestBackend::new(12, 4)).unwrap();
+    terminal.draw(|frame| {
+        render_layout_json(
+            frame, &layout(), Rect::new(0, 0, 12, 4), false,
+            Style::default().fg(Color::DarkGray), Style::default().fg(Color::Green),
+            false, Color::Cyan, Some(Rect::new(0, 0, 12, 2)), "", false,
+            "off", "", 2, crate::border_lines::border_chars("single"), None,
+            WindowContentStyles::default(), PaneBorderIndicators::Colour,
+        );
+    }).unwrap();
+    let buffer = terminal.backend().buffer();
+    let row = |y| (0..12).map(|x| buffer[(x, y)].symbol()).collect::<String>();
+    assert_eq!(row(1), "? shortcuts ");
+    assert_eq!(row(2), "HUD         ");
+    let footer = &buffer[(0, 1)];
+    assert_eq!(footer.fg, Color::Red);
+    assert_eq!(footer.bg, Color::Blue);
+    assert!(footer.modifier.contains(Modifier::BOLD));
+    assert!(footer.modifier.contains(Modifier::UNDERLINED));
+    assert!(!buffer[(0, 2)].modifier.contains(Modifier::UNDERLINED));
+}
+
+#[test]
+fn compact_hit_target_is_upper_last_row_and_not_the_hud_first_row() {
+    let mut borders = Vec::new();
+    collect_layout_borders(&layout(), Rect::new(0, 0, 12, 4), &mut vec![], &mut borders);
+    assert_eq!(borders.len(), 1);
+    assert_eq!(borders[0].3, 1);
+    let geometry = border_geometry_from_layout(&layout(), Rect::new(0, 0, 12, 4), Rect::new(0, 0, 12, 4), false);
+    // Compact rules are text attributes, not box-drawing cells. They must not
+    // enter the glyph replacement/intersection/arrow passes.
+    assert!(!geometry.contains_horizontal(12));
+}
+
+#[test]
+fn zero_cell_neighbor_has_no_compact_drag_target() {
+    let layout = LayoutJson::Split { kind: "Vertical".into(), sizes: vec![59, 1, 30],
+        children: vec![pane(1, true, &["A"]), pane(2, false, &["B"]), pane(3, false, &["C"])] };
+    let mut borders = Vec::new();
+    collect_layout_borders(&layout, Rect::new(0, 0, 12, 2), &mut vec![], &mut borders);
+    assert!(borders.is_empty(), "zero-cell pairs cannot resize: {borders:?}");
+}
+
+fn status_off_content_area(terminal: Rect) -> Rect {
+    Layout::default().direction(Direction::Vertical)
+        .constraints([Constraint::Min(1), Constraint::Length(0)])
+        .split(terminal)[0]
+}
+
+#[test]
+fn hidden_status_client_size_draw_area_and_drag_weights_agree() {
+    let terminal = Rect::new(0, 0, 12, 32);
+    let reported_height = terminal.height - crate::hud_compact::client_status_reserve(false, 1);
+    let content = status_off_content_area(terminal);
+    let server_cells = split_with_gaps(false, &[25, 7], Rect::new(0, 0, 12, reported_height));
+    let mut borders = Vec::new();
+    let layout = LayoutJson::Split { kind: "Vertical".into(), sizes: vec![25, 7],
+        children: vec![pane(1, true, &["source"]), pane(2, false, &["HUD"])] };
+    collect_layout_borders(&layout, content, &mut vec![], &mut borders);
+    assert_eq!(reported_height, content.height, "client-size and draw viewport diverged");
+    assert_eq!(borders[0].4, reported_height);
+    let drag = crate::hud_compact::drag_sizes(false, &borders[0].5, borders[0].4);
+    assert_eq!(drag, server_cells.iter().map(|rect| rect.height).collect::<Vec<_>>());
+}
+
+#[test]
+fn hidden_status_footer_stays_on_last_source_row_after_drag_sized_frame() {
+    let terminal_area = Rect::new(0, 0, 12, 32);
+    let reported_height = terminal_area.height - crate::hud_compact::client_status_reserve(false, 1);
+    let server_cells = split_with_gaps(false, &[25, 7], Rect::new(0, 0, 12, reported_height));
+    let mut source_lines = vec![""; server_cells[0].height as usize];
+    *source_lines.last_mut().unwrap() = "? shortcuts";
+    let mut hud_lines = vec![""; server_cells[1].height as usize];
+    hud_lines[0] = "HUD";
+    let layout = LayoutJson::Split { kind: "Vertical".into(), sizes: vec![25, 7],
+        children: vec![pane(1, true, &source_lines), pane(2, false, &hud_lines)] };
+    let content = status_off_content_area(terminal_area);
+    let client_cells = split_with_gaps(false, &[25, 7], content);
+    let mut terminal = Terminal::new(TestBackend::new(12, 32)).unwrap();
+    terminal.draw(|frame| {
+        render_layout_json(frame, &layout, content, false,
+            Style::default().fg(Color::DarkGray), Style::default().fg(Color::Green),
+            false, Color::Cyan, Some(client_cells[0]), "", false, "off", "", 2,
+            crate::border_lines::border_chars("single"), None,
+            WindowContentStyles::default(), PaneBorderIndicators::Colour);
+    }).unwrap();
+    let last_source_row = client_cells[0].y + client_cells[0].height - 1;
+    let footer = (0..12).map(|x| terminal.backend().buffer()[(x, last_source_row)].symbol()).collect::<String>();
+    assert_eq!(footer, "? shortcuts ", "unused client-only row remains under the footer");
+}
