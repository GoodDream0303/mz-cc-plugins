+//! Shared character-cell policy for the opt-in HUD compact backend.
+//! Kept dependency-free so geometry and gesture policy can be checked with
+//! `rustc --edition=2021 --test --cfg 'feature="hud-compact"' src/hud_compact.rs`.
+
+pub const ENABLED: bool = cfg!(feature = "hud-compact");
+
+/// Rows excluded from client-size for the server's own status bar.
+pub fn client_status_reserve(visible: bool, configured_lines: usize) -> u16 {
+    let drawn = if visible { configured_lines as u16 } else { 0 };
+    // The compact client draws no status row when status is off. Reporting
+    // one fewer row would leave its pane rects taller than the server PTYs,
+    // producing a persistent blank footer row after border dragging.
+    if ENABLED { drawn } else { drawn.max(1) }
+}
+
+pub fn separator_gap(is_horizontal: bool) -> u16 {
+    if ENABLED && !is_horizontal { 0 } else { 1 }
+}
+
+pub fn separator_position(is_horizontal: bool, origin: u16, length: u16) -> Option<u16> {
+    if ENABLED && !is_horizontal {
+        length.checked_sub(1).and_then(|last| origin.checked_add(last))
+    } else {
+        origin.checked_add(length)
+    }
+}
+
+pub fn drag_allowed(is_horizontal: bool, alt: bool) -> bool {
+    !ENABLED || is_horizontal || alt
+}
+
+pub fn drag_pair_resizable(sizes: &[u16], index: usize) -> bool {
+    sizes.get(index).zip(index.checked_add(1).and_then(|next| sizes.get(next)))
+        .is_some_and(|(&first, &second)| first > 0 && second > 0)
+}
+
+/// Weights for a newly created stacked split. Normal builds preserve the
+/// upstream percentage calculation; compact cell-count requests use actual
+/// cell weights to avoid rounding away a requested HUD row.
+pub fn requested_split_weights(parent_length: u16, requested: u16, percent: bool) -> [u16; 2] {
+    if ENABLED && !percent && parent_length >= 2 {
+        let second = requested.clamp(1, parent_length - 1);
+        return [parent_length - second, second];
+    }
+    let pct = if percent {
+        requested.clamp(1, 99)
+    } else if parent_length > 0 {
+        ((requested as u32 * 100) / parent_length as u32).clamp(1, 99) as u16
+    } else { 50 };
+    [100 - pct, pct]
+}
+
+/// Relative (offset, length) pairs, preserving upstream proportional sizing,
+/// last-child remainder and minimum-cell redistribution.
+pub fn split_cells(is_horizontal: bool, sizes: &[u16], length: u16, min_cell: u16) -> Vec<(u16, u16)> {
+    let n = sizes.len();
+    if n == 0 { return Vec::new(); }
+    if n == 1 { return vec![(0, length)]; }
+    let gap = separator_gap(is_horizontal);
+    let available = length.saturating_sub((n - 1) as u16 * gap);
+    let total: u32 = sizes.iter().map(|&s| s as u32).sum();
+    if total == 0 { return vec![(0, length); n]; }
+    let mut cells = Vec::with_capacity(n);
+    let mut running: u16 = 0;
+    for (i, &weight) in sizes.iter().enumerate() {
+        let size = if i == n - 1 {
+            available.saturating_sub(running)
+        } else {
+            let size = (available as u32 * weight as u32 / total) as u16;
+            running = running.saturating_add(size);
+            size
+        };
+        cells.push(size);
+    }
+    if available >= n as u16 * min_cell {
+        loop {
+            let Some(short) = cells.iter().position(|&size| size < min_cell) else { break; };
+            // Choose the first largest sibling, as the original layout does.
+            let mut largest = 0;
+            for index in 0..n {
+                if cells[index] > cells[largest] { largest = index; }
+            }
+            if cells[largest] <= min_cell { break; }
+            cells[largest] -= 1;
+            cells[short] += 1;
+        }
+    }
+    let mut offset = 0;
+    cells.into_iter().enumerate().map(|(index, size)| {
+        let start = offset + index as u16 * gap;
+        offset += size;
+        (start, size)
+    }).collect()
+}
+
+/// Capture drag weights from the current viewport, rather than the dimensions
+/// at which the split was originally created.
+pub fn drag_sizes(is_horizontal: bool, sizes: &[u16], length: u16) -> Vec<u16> {
+    if ENABLED && !is_horizontal {
+        split_cells(false, sizes, length, 1).into_iter().map(|(_, size)| size).collect()
+    } else {
+        sizes.to_vec()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn hidden_status_reports_the_same_rows_that_the_client_draws() {
+        assert_eq!(client_status_reserve(false, 1), if ENABLED { 0 } else { 1 });
+        assert_eq!(client_status_reserve(false, 3), if ENABLED { 0 } else { 1 });
+        assert_eq!(client_status_reserve(true, 0), if ENABLED { 0 } else { 1 });
+        assert_eq!(client_status_reserve(true, 1), 1);
+        assert_eq!(client_status_reserve(true, 3), 3);
+    }
+
+    #[test]
+    fn status_visibility_transitions_change_the_reported_reserve() {
+        let sequence = [(true, 1), (false, 1), (true, 3), (false, 3)];
+        let reserves: Vec<u16> = sequence.into_iter()
+            .map(|(visible, lines)| client_status_reserve(visible, lines)).collect();
+        assert_eq!(reserves, if ENABLED { vec![1, 0, 3, 0] } else { vec![1, 1, 3, 1] });
+    }
+
+    #[test]
+    fn stacked_panes_reclaim_exactly_one_separator_row() {
+        let cells = split_cells(false, &[4, 1], 30, 1);
+        if ENABLED {
+            assert_eq!(cells, vec![(0, 24), (24, 6)]);
+            assert_eq!(cells.iter().map(|(_, height)| *height).sum::<u16>(), 30);
+        } else {
+            assert_eq!(cells, vec![(0, 23), (24, 6)]);
+        }
+    }
+
+    #[test]
+    fn side_by_side_panes_keep_one_separator_column() {
+        assert_eq!(split_cells(true, &[1, 1], 11, 2), vec![(0, 5), (6, 5)]);
+    }
+
+    #[test]
+    fn nested_stacks_use_adjacent_rows_at_every_level() {
+        let outer = split_cells(false, &[2, 1], 12, 1);
+        let inner = split_cells(false, &[1, 1], outer[0].1, 1);
+        if ENABLED {
+            assert_eq!(outer, vec![(0, 8), (8, 4)]);
+            assert_eq!(inner, vec![(0, 4), (4, 4)]);
+            assert_eq!(inner[1].0 + inner[1].1, outer[1].0);
+        } else {
+            assert_eq!(outer, vec![(0, 7), (8, 4)]);
+            assert_eq!(inner, vec![(0, 3), (4, 3)]);
+        }
+    }
+
+    #[test]
+    fn compact_boundary_hit_row_belongs_to_upper_pane() {
+        assert_eq!(separator_position(false, 4, 6), Some(if ENABLED { 9 } else { 10 }));
+        assert_eq!(separator_position(true, 4, 6), Some(10));
+        if ENABLED { assert_eq!(separator_position(false, 4, 0), None); }
+    }
+
+    #[test]
+    fn ordinary_selection_never_starts_compact_resize() {
+        assert_eq!(drag_allowed(false, false), !ENABLED);
+        assert!(drag_allowed(false, true));
+        assert!(drag_allowed(true, false));
+    }
+
+    #[test]
+    fn one_row_panes_remain_one_row_and_empty_splits_are_safe() {
+        assert!(split_cells(false, &[], 2, 1).is_empty());
+        assert_eq!(split_cells(false, &[1], 1, 1), vec![(0, 1)]);
+        if ENABLED { assert_eq!(split_cells(false, &[0, 100], 2, 1), vec![(0, 1), (1, 1)]); }
+    }
+
+    #[test]
+    fn compact_cell_requests_avoid_integer_percentage_rounding() {
+        let weights = requested_split_weights(130, 5, false);
+        if ENABLED {
+            assert_eq!(weights, [125, 5]);
+            assert_eq!(split_cells(false, &weights, 130, 1), vec![(0, 125), (125, 5)]);
+        } else { assert_eq!(weights, [97, 3]); }
+        assert_eq!(requested_split_weights(130, 25, true), [75, 25]);
+    }
+
+    #[test]
+    fn compact_drag_after_resize_moves_in_current_cell_units() {
+        let sizes = drag_sizes(false, &[24, 6], 60);
+        if ENABLED {
+            assert_eq!(sizes, vec![48, 12]);
+            assert_eq!(split_cells(false, &[sizes[0] + 1, sizes[1] - 1], 60, 1), vec![(0, 49), (49, 11)]);
+        } else { assert_eq!(sizes, vec![24, 6]); }
+        assert_eq!(drag_sizes(true, &[24, 6], 60), vec![24, 6]);
+    }
+
+    #[test]
+    fn zero_cell_adjacent_pairs_cannot_reach_resize_clamping() {
+        assert!(!drag_pair_resizable(&[1, 0, 1], 0));
+        assert!(!drag_pair_resizable(&[1, 0, 1], 1));
+        assert!(!drag_pair_resizable(&[], 0));
+        assert!(drag_pair_resizable(&[1, 1], 0));
+    }
+}
