{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/src/codex_hooks.py\"",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/src/codex_hooks.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/src/codex_hooks.py\"",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/src/codex_hooks.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/src/codex_hooks.py\"",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/src/codex_hooks.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/src/codex_hooks.py\"",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/src/codex_hooks.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/src/codex_hooks.py\"",
            "commandWindows": "python -B \"$env:PLUGIN_ROOT/src/codex_hooks.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
